{
  "crons": [
    { "path": "/api/cron/bulletin", "schedule": "0 0 * * *" },
    { "path": "/api/selfcheck", "schedule": "0 3 * * *" }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
