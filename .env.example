# ── Supabase (backend) ──
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # NUNCA expor no frontend

# ── Token do MT4 (header x-mt4-token no POST /api/signals) ──
MT4_TOKEN=troque-por-um-token-longo-aleatorio

# ── Web Push / VAPID (gerar: npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@infinitysignals.app

# ── Expostas ao frontend (prefixo VITE_) ──
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_VAPID_PUBLIC_KEY=
